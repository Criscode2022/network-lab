# Nest API (long-running Node — do not freeze the forwarding engine on a 10s serverless timeout)
PORT=3001
JWT_SECRET=change-me
DATABASE_URL=postgres://USER:PASSWORD@HOST/netbench?sslmode=require

# Optional: when set, API persists users/labs to Neon Postgres
# DATABASE_URL=

# Eve agent (Vercel AI Gateway — no raw provider keys)
AI_GATEWAY_API_KEY=
# Optional Eve tuning (defaults in apps/eve-agent/agent/lib/model.ts)
# EVE_MODEL=minimax/minimax-m3
# EVE_FALLBACK_MODELS=openai/gpt-5.4-mini,google/gemini-2.5-flash,google/gemini-2.5-flash-lite,openai/gpt-4.1-mini
# EVE_CONTEXT_TOKENS=200000
# EVE_REQUIRE_APPROVAL=1     # pause mutating tools for a human Approve (default: auto-run)
# EVE_NEST_RETRIES=2         # retries per Nest call on network/429/5xx
# Local: Nest on :3001. On Vercel/Railway, defaults to the public API if unset.
NETBENCH_API_URL=http://127.0.0.1:3001
NETBENCH_API_TOKEN=

# Angular
# ng serve proxies /api → PORT 3001
