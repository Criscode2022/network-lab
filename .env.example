# Nest API (long-running Node — do not freeze the forwarding engine on a 10s serverless timeout)
PORT=3001
JWT_SECRET=change-me
DATABASE_URL=postgres://USER:PASSWORD@HOST/netbench?sslmode=require

# Optional: when set, API persists users/labs to Neon Postgres
# DATABASE_URL=

# Eve agent (Vercel AI Gateway — no raw provider keys)
AI_GATEWAY_API_KEY=
# Optional Eve tuning (defaults in apps/eve-agent/agent/lib/model.ts, nest.ts, approval.ts)
# EVE_MODEL=minimax/minimax-m3
# Fallback chain, different providers on purpose; the Gateway tries them in order inside one call and eve rotates
# to the next one across calls when a step still fails (durable per session, primary retried after EVE_MODEL_RECOVER_MINUTES).
# EVE_FALLBACK_MODELS=openai/gpt-5.6-luna,google/gemini-3.7-flash,zai/glm-5.3-flash,deepseek/deepseek-v4-flash,openai/gpt-5.4-mini
# EVE_CONTEXT_TOKENS=200000          # cap on the context window eve assumes (compaction at 80 %)
# EVE_MODEL_RECOVER_MINUTES=15
# EVE_APPROVAL=auto                  # auto (never pause) | dangerous (pause on destructive calls) | once | always
# EVE_REQUIRE_APPROVAL=1             # legacy alias for EVE_APPROVAL=always
# EVE_NEST_RETRIES=2                 # retries per Nest call on network/timeout/429/5xx (Retry-After honoured)
# EVE_NEST_TIMEOUT_MS=25000          # per-attempt timeout (build_lab uses 60 s)
# Local: Nest on :3001. On Vercel/Railway, defaults to the public API if unset.
NETBENCH_API_URL=http://127.0.0.1:3001
NETBENCH_API_TOKEN=

# Angular
# ng serve proxies /api → PORT 3001
