{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netbench.local/schema/lab.schema.json",
  "title": "NetBench Lab",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "devices", "links", "checks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "goal": { "type": "string" },
    "differsNote": { "type": "string" },
    "kind": {
      "enum": ["model", "exercise"],
      "description": "model = passes Check as shipped (reference). exercise = ships broken/incomplete and carries a solution. Absent means model."
    },
    "level": { "enum": ["beginner", "intermediate", "advanced", "expert"] },
    "topics": { "type": "array", "maxItems": 12, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,23}$" } },
    "modelId": { "type": "string", "description": "Exercise only: id of the model lab showing the working version." },
    "solution": {
      "type": "object",
      "description": "Exercise only: the official fix. Applying patch to the shipped lab makes every check pass.",
      "required": ["summary", "hints", "patch"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "hints": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "patch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "addDevices": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "name"],
                "properties": {
                  "type": { "enum": ["workstation", "server", "switch", "router", "firewall", "ap", "wlc", "cloud"] },
                  "switchProfile": {
                    "enum": ["unmanaged", "managed-l2", "multilayer"],
                    "description": "Only for type=switch. Absent means managed-l2."
                  },
                  "name": { "type": "string" },
                  "x": { "type": "number" },
                  "y": { "type": "number" }
                }
              }
            },
            "removeDeviceIds": { "type": "array", "items": { "type": "string" } },
            "addLinks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["a", "b"],
                "properties": {
                  "a": { "type": "string", "description": "Name:iface" },
                  "b": { "type": "string" },
                  "cable": { "enum": ["ethernet", "straight", "crossover", "fiber"] }
                }
              }
            },
            "removeLinks": { "type": "array", "items": { "type": "string" } },
            "configs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["device", "commands"],
                "properties": {
                  "device": { "type": "string" },
                  "commands": { "type": "array", "minItems": 1, "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "name", "x", "y"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "enum": ["workstation", "server", "switch", "router", "firewall", "ap", "wlc", "cloud"]
          },
          "switchProfile": {
            "enum": ["unmanaged", "managed-l2", "multilayer"],
            "description": "Only for kind=switch. Absent means managed-l2."
          },
          "name": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "hostname": { "type": "string" },
          "startup": { "type": "array", "items": { "type": "string" } },
          "post": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["a", "b"],
        "properties": {
          "a": { "type": "string", "description": "Name:iface" },
          "b": { "type": "string" },
          "cable": {
            "enum": ["ethernet", "straight", "crossover", "fiber"],
            "description": "ethernet is auto-MDIX (default). straight/crossover follow CCNA like/unlike rules. fiber needs SFP-capable devices."
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "src", "dst"],
            "properties": {
              "type": { "const": "ping" },
              "src": { "type": "string" },
              "dst": { "type": "string" },
              "family": { "enum": ["v4", "v6"] }
            }
          },
          {
            "type": "object",
            "required": ["type", "src", "dst", "expect"],
            "properties": {
              "type": { "const": "ssh" },
              "src": { "type": "string" },
              "dst": { "type": "string" },
              "expect": { "enum": ["allow", "deny"] }
            }
          },
          {
            "type": "object",
            "required": ["type", "client"],
            "properties": { "type": { "const": "wifi-associated" }, "client": { "type": "string" } }
          },
          {
            "type": "object",
            "required": ["type", "device"],
            "properties": { "type": { "const": "dhcp-bound" }, "device": { "type": "string" } }
          },
          {
            "type": "object",
            "required": ["type", "a", "b"],
            "properties": { "type": { "const": "ospf-full" }, "a": { "type": "string" }, "b": { "type": "string" } }
          }
        ]
      }
    }
  }
}
